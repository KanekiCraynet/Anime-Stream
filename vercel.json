{
  "version": 2,
  "regions": [
    "sin1"
  ],
  "env": {
    "NODE_ENV": "production",
    "VERCEL": "1",
    "TRUST_PROXY": "1",
    "SESSION_SECRET": "kitanime-super-secret-key-2025-production-32-chars",
    "CSRF_SECRET": "kitanime-csrf-secret-key-2025-production",
    "API_BASE_URL": "https://anime-stream-delta.vercel.app/v1",
    "CORS_ORIGIN": "https://anime-stream-delta.vercel.app",
    "SITE_URL": "https://anime-stream-delta.vercel.app",
    "UPSTREAM_API_BASE_URL": "https://anime-stream-delta.vercel.app/v1",
    "ASSETS_URL": "https://anime-stream-delta.vercel.app",
    "CDN_URL": "https://anime-stream-delta.vercel.app",
    "STATIC_URL": "https://anime-stream-delta.vercel.app/public",
    "ENABLE_ANALYTICS": "true",
    "ENABLE_ADSENSE": "true",
    "ENABLE_CACHING": "true",
    "ENABLE_COMPRESSION": "true",
    "VERCEL_ANALYTICS_ID": "prj_anime-stream-delta"
  },
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "app.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/stream",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
        "Access-Control-Allow-Headers": "Range, Content-Type",
        "Cache-Control": "public, max-age=31536000"
      },
      "dest": "/app.js"
    },
    {
      "src": "/proxy",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Cache-Control": "public, max-age=3600"
      },
      "dest": "/app.js"
    },
    {
      "src": "/v1/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/app.js"
    }
  ],
  "buildCommand": "npm run build",
  "installCommand": "npm install"
}